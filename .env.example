# ISP Operations ERP — environment variables.
# Copy this file to `.env` (backend) and to project root for Docker Compose
# and replace the values. NEVER commit the real `.env` file.

# ── Django-style shared ────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
LOG_LEVEL=INFO

# ── Backend (FastAPI) ──────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
API_PREFIX=/api/v1

# ── Security ───────────────────────────────────────────────────────────
# Generate a 32+ byte random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-please-32-bytes-min-length-xxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_SCHEMES=argon2,bcrypt
ADMIN_EMAIL=admin@isp-erp.example.com
ADMIN_PASSWORD=change-me-now   # initial seeded admin password; set a strong value in prod

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=isp_erp
POSTGRES_USER=isp_erp
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://isp_erp:change-me@db:5432/isp_erp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=https://qberp.qbinternet.com,http://localhost:5173,http://localhost:3000

# ── Frontend (Vite) ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1